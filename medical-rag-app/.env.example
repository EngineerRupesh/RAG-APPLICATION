# Copy this file to ".env" in the backend/ folder and fill in your values.
# (start.sh / start.bat do this for you automatically on first run.)

# --- LLM provider: "gemini" (default), "openai", "anthropic", or "ollama" ---
LLM_PROVIDER=ollama

# Required: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional - only needed if you switch LLM_PROVIDER above
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL_NAME=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL_NAME=claude-sonnet-4-6

# Local Llama via Ollama - no API key needed. Install Ollama (ollama.com),
# run `ollama pull llama3.1` once, then set LLM_PROVIDER=ollama above.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1

LLM_TEMPERATURE=0.0

# --- Local embedding model (downloaded once from HuggingFace) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking / retrieval tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVE_K=10
RERANK_TOP_K=4
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=*
